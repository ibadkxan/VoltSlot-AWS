# Flask
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
LOG_LEVEL=INFO
PORT=5000

# Local MySQL. For AWS RDS, replace DB_HOST with the RDS endpoint.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ev_charging_db
DB_USER=root
DB_PASSWORD=your-local-mysql-password
DB_CONNECT_TIMEOUT=10
# Optional: path to the Amazon RDS CA bundle when enforcing TLS.
# DB_SSL_CA=./certs/global-bundle.pem

# AWS integrations. Leave SNS_BOOKING_TOPIC_ARN empty for local development.
AWS_REGION=ap-south-1
SNS_BOOKING_TOPIC_ARN=

# Optional S3 public asset base URL after uploading static assets.
# Example: https://your-bucket.s3.ap-south-1.amazonaws.com
ASSET_BASE_URL=
